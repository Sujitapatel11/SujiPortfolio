# Database configuration
DATABASE_URL=postgresql://suji_user:suji_password@db:5432/sujis_world_db

# Local fallback (SQLite) if running outside Docker without Postgres:
# DATABASE_URL=sqlite:///./sujis_world.db

# LLM API Keys (Provide OpenAI or Anthropic key)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Job Hunter API Providers (Configure keys for autonomous job discovery)
# Free/public endpoints used wherever permitted; missing keys keep that provider cleanly disabled
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JOOBLE_API_KEY=
SERPAPI_API_KEY=
USAJOBS_API_KEY=
USAJOBS_USER_AGENT=

# Job Hunter Search Defaults & Autonomous Scheduler
JOB_HUNTER_SCHEDULER_ENABLED=false
JOB_HUNTER_INTERVAL_HOURS=6
JOB_SEARCH_LOCATION=Remote
JOB_SEARCH_COUNTRY=de

# App configuration
ENVIRONMENT=development
PORT=8000

# Admin authentication
ADMIN_USERNAME=suji
ADMIN_PASSWORD_HASH=$2b$12$EixZaYVK1fsbw1ZfbX3OXePaWxn96p36WQoeG6Lruj3vjPGga31lW
JWT_SECRET_KEY=change_this_to_a_secure_random_jwt_secret_in_production
JWT_ALGORITHM=HS256

# Twilio WhatsApp notifications (WhatsApp Sandbox credentials)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
ADMIN_WHATSAPP_NUMBER=+9779815280946
ADMIN_DASHBOARD_URL=http://localhost:5173/admin
