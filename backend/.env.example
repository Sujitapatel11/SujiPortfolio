# Database configuration
DATABASE_URL=postgresql://suji_user:suji_password@db:5432/sujis_world_db

# Local fallback (SQLite) if running outside Docker without Postgres:
# DATABASE_URL=sqlite:///./sujis_world.db

# LLM API Keys (Provide OpenAI or Anthropic key)
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# App configuration
ENVIRONMENT=development
PORT=8000

# Admin authentication
ADMIN_USERNAME=suji
ADMIN_PASSWORD_HASH=$2b$12$EixZaYVK1fsbw1ZfbX3OXePaWxn96p36WQoeG6Lruj3vjPGga31lW
JWT_SECRET_KEY=change_this_to_a_secure_random_jwt_secret_in_production
JWT_ALGORITHM=HS256

# Twilio WhatsApp notifications (WhatsApp Sandbox credentials)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
ADMIN_WHATSAPP_NUMBER=+<country-code><number>
ADMIN_DASHBOARD_URL=http://localhost:5173/admin

# Portfolio inquiry email notifications (Gmail SMTP example)
# Use a Google App Password, not your normal account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-gmail-address@gmail.com
SMTP_PASSWORD=your-16-character-google-app-password
SMTP_FROM_EMAIL=your-gmail-address@gmail.com
INQUIRY_NOTIFICATION_EMAIL=your-notification-address@example.com
